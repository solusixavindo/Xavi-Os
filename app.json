{
  "expo": {
    "name": "XAVI-OS",
    "slug": "xavi-os",
    "scheme": "xavi-os",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xavindo.xavios",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.xavindo.xavios",
      "adaptiveIcon": {
        "backgroundColor": "#050B18"
      }
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ]
  }
}
